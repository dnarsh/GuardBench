 def page(items, number, size):
+    """Helper: page."""
     start = (number - 1) * size
     return items[start:start + size]
 
 
 def overdue(tickets, today, sla_days):
+    """Helper: overdue."""
     return [t for t in tickets if today - t["opened"] >= sla_days]
 
 
 def page_count(total, size):
+    """Helper: page count."""
     return (total + size - 1) // size
 
