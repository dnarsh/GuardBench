@@ -1,15 +1,20 @@
-"""Delivery retry schedule for the sender side."""
-BASE = 2
-CAP = 300
+"""Delivery retry schedule for the sender side.
+
+Exponential backoff, no jitter.
+"""
+BASE = 2  # seconds, doubled each attempt
+CAP = 300  # never wait longer than five minutes
 
 
 def delay(attempt):
     """Seconds to wait before retry number `attempt` (1-based), doubling up to CAP."""
     if attempt < 1:
         raise ValueError("attempt starts at 1")
-    return min(BASE ** attempt, CAP)
+    wait = BASE ** attempt
+    return min(wait, CAP)
 
 
 def schedule(attempts):
+    """Waits for retries 1..attempts."""
     return [delay(n) for n in range(1, attempts + 1)]
 
